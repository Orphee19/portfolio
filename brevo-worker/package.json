{
  "name": "brevo-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Proxy Brevo pour le portfolio (clé API hors front)",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "secret:brevo": "wrangler secret put BREVO_API_KEY",
